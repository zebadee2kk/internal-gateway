# Environment template for the internal gateway.
# Copy to .env and fill in your own values.

# Full JSON-RPC endpoint for the gateway.
GATEWAY_URL=https://mcp-gateway.co.uk/mcp

# Bearer token issued by the gateway operator.
# Placeholder only — replace with the token you were given,
# or note it in a comment like:  Authorization: Bearer <redacted>
GATEWAY_BEARER_TOKEN=<redacted>

# Optional overrides
GATEWAY_TIMEOUT_SECONDS=30
GATEWAY_LOG_LEVEL=info
